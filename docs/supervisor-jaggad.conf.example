# Contoh Konfigurasi Supervisor Queue Worker untuk JAGGAD Academy
# Letakkan di /etc/supervisor/conf.d/jaggad-worker.conf

[program:jaggad-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/jaggad/artisan queue:work --sleep=3 --tries=3 --timeout=60 --max-time=3600
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=2
redirect_stderr=true
stdout_logfile=/var/www/jaggad/storage/logs/worker.log
stopwaitsecs=3600
